# Templat aturan udev untuk persistent symlinks perangkat duplikat
# Identifikasi atribut unik perangkat dengan: udevadm info -a -p /sys/class/<class>/<device>

# Contoh untuk webcam dan TV tuner:
# KERNEL=="video*", ATTRS{idProduct}=="1910", ATTRS{idVendor}=="0d81", SYMLINK+="webcam"
# KERNEL=="video*", ATTRS{device}=="0x036f",  ATTRS{vendor}=="0x109e", SYMLINK+="tvtuner"