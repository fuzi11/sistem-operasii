#!/bin/busybox sh
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1 </dev/console

emerg() {
  echo "[webforge] GAGAL: $1"
  echo "[webforge] shell darurat. Cek: cat /proc/partitions ; dmesg | tail -40"
  exec sh
}

echo "[webforge] mencari media live (maks 60 detik)..."
found=
for i in $(seq 1 60); do
  for d in /dev/sr* /dev/sd* /dev/vd* /dev/nvme*n*; do
    [ -b "$d" ] || continue
    for fs in iso9660 vfat ext4; do
      mount -t $fs -o ro "$d" /mnt/iso 2>/dev/null || continue
      if [ -f /mnt/iso/live/filesystem.squashfs ]; then found="$d ($fs)"; break 3; fi
      umount /mnt/iso
    done
  done
  [ $((i % 5)) -eq 0 ] && echo "  ...menunggu perangkat ($i detik)"
  sleep 1
done
[ -n "$found" ] || emerg "media live tidak ditemukan"
echo "[webforge] media: $found"

mount -t squashfs -o loop,ro /mnt/iso/live/filesystem.squashfs /mnt/ro || emerg "mount squashfs gagal"
mount -t tmpfs tmpfs /mnt/rw
mkdir -p /mnt/rw/upper /mnt/rw/work
mount -t overlay overlay \
  -o lowerdir=/mnt/ro,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work /newroot \
  || emerg "mount overlay gagal"

for d in proc sys dev run tmp mnt; do mkdir -p /newroot/$d; done
chmod 1777 /newroot/tmp
mkdir -p /newroot/mnt/live/medium /newroot/mnt/live/rootfs /newroot/mnt/live/rw
mount --move /mnt/iso /newroot/mnt/live/medium
mount --move /mnt/ro  /newroot/mnt/live/rootfs
mount --move /mnt/rw  /newroot/mnt/live/rw
mount --move /dev  /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys  /newroot/sys

exec switch_root /newroot /sbin/init
